    "acceptance_start": "acceptance_start_datetime",
    "deadline": "acceptance_end_datetime",
    "max_amount": "subsidy_max_limit",
    "target_area": "target_area_search",
    "target_employees": "target_number_of_employees"
  },
  "quality_gate": {
    "required_fields": ["id", "title", "acceptance_end_datetime"],
